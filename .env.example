# ============================================================
# SupportPilot AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_ENV=development                   # development | staging | production
APP_NAME=SupportPilot AI
APP_VERSION=1.0.0
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ----------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------
POSTGRES_USER=supportpilot
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=supportpilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ----------------------------------------------------------
# ChromaDB (Vector Store)
# ----------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=supportpilot_docs

# ----------------------------------------------------------
# AI Provider
# ----------------------------------------------------------
DEFAULT_AI_PROVIDER=gemini            # gemini | openai (future)
DEFAULT_MODEL=gemini-2.0-flash
DEFAULT_EMBEDDING_MODEL=models/text-embedding-004

# Gemini
GEMINI_API_KEY=CHANGE_ME_your_gemini_api_key

# OpenAI (optional / future provider)
# OPENAI_API_KEY=CHANGE_ME_your_openai_api_key

# ----------------------------------------------------------
# n8n Automation
# ----------------------------------------------------------
N8N_HOST=n8n
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_password
N8N_WEBHOOK_URL=http://${N8N_HOST}:${N8N_PORT}/webhook
N8N_API_KEY=CHANGE_ME_n8n_api_key
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_encryption_key

# ----------------------------------------------------------
# Backend API
# ----------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# ----------------------------------------------------------
# Frontend (Next.js)
# ----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=SupportPilot AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# ----------------------------------------------------------
# File Uploads
# ----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=pdf,txt,md,docx,html

# ----------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
