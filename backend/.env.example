# SupportPilot AI — Backend Environment Configuration Example
# Copy to backend/.env or use root .env

APP_ENV=development
APP_NAME=SupportPilot AI
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_32_character_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database
POSTGRES_USER=supportpilot
POSTGRES_PASSWORD=supportpilot_password
POSTGRES_DB=supportpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://supportpilot:supportpilot_password@localhost:5432/supportpilot
DATABASE_URL_SYNC=postgresql://supportpilot:supportpilot_password@localhost:5432/supportpilot

# Redis
REDIS_URL=redis://localhost:6379/0

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
