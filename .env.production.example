# ============================================================
# SupportPilot AI — Production Environment Variables Template
# Copy to .env.production and fill in with real production secrets.
# NEVER commit .env.production to version control.
# ============================================================

# ── 1. Application Runtime ────────────────────────────────────
APP_ENV=production
APP_NAME="SupportPilot AI Enterprise"
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── 2. Security & JWT Authentication ─────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_SECURE_64_CHAR_HEX_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 3. Production PostgreSQL Database ─────────────────────────
POSTGRES_USER=supportpilot_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD
POSTGRES_DB=supportpilot_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── 4. AI Engine & Provider Credentials ──────────────────────
DEFAULT_AI_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.0-flash
DEFAULT_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_GEMINI_PRODUCTION_API_KEY

# ── 5. Vector Store (ChromaDB) ────────────────────────────────
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION_NAME=supportpilot_docs_prod

# ── 6. n8n Workflow Automation ────────────────────────────────
N8N_HOST=n8n
N8N_PORT=5678
N8N_WEBHOOK_URL=http://n8n:5678/webhook
# Generate with: openssl rand -hex 24
N8N_API_KEY=REPLACE_WITH_HMAC_SHARED_SECRET
N8N_ENCRYPTION_KEY=REPLACE_WITH_N8N_ENCRYPTION_KEY

# ── 7. Caddy Ingress & Automatic HTTPS ───────────────────────
ACME_EMAIL=admin@yourdomain.com
DOMAIN_APP=app.yourdomain.com
DOMAIN_API=api.yourdomain.com
DOMAIN_N8N=n8n.yourdomain.com

# ── 8. Networking, CORS & Reverse Proxy ───────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# ── 9. Frontend Public Configuration ──────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_NAME="SupportPilot AI"

# ── 10. Production Rate Limiting ──────────────────────────────
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# ── 11. File Storage & Quotas ─────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=pdf,docx,txt,md
UPLOAD_DIR=/app/uploads
