# ============================================================
# SupportPilot AI — GCP Production Environment Variables
# !! NEVER commit this file. !!
# Copy to .env.gcp and populate with real values.
# On GCP, most secrets are pulled from Secret Manager at startup.
# ============================================================

# ── 1. GCP Project Configuration ─────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# ── 2. Secret Manager ─────────────────────────────────────────
# Set to true on GCP so secrets are pulled at startup
GCP_SECRET_MANAGER_ENABLED=true
# SA key path is mounted into the container by the startup script
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-sa-key.json

# ── 3. Application Runtime ─────────────────────────────────────
APP_ENV=production
APP_NAME="SupportPilot AI Enterprise"
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── 4. Security & JWT (overridden by Secret Manager in production)
# Generate with: openssl rand -hex 32
SECRET_KEY=OVERRIDDEN_BY_SECRET_MANAGER
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 5. PostgreSQL (overridden by Secret Manager in production)
POSTGRES_USER=supportpilot_admin
POSTGRES_PASSWORD=OVERRIDDEN_BY_SECRET_MANAGER
POSTGRES_DB=supportpilot_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL is built dynamically from POSTGRES_* vars above in docker-compose

# ── 6. AI Engine & Gemini (overridden by Secret Manager)
DEFAULT_AI_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.0-flash
DEFAULT_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_API_KEY=OVERRIDDEN_BY_SECRET_MANAGER

# ── 7. ChromaDB (internal network only)
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=supportpilot_docs_prod

# ── 8. n8n Workflow Automation (overridden by Secret Manager)
N8N_HOST=n8n.yourdomain.com
N8N_PORT=5678
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook
N8N_API_KEY=OVERRIDDEN_BY_SECRET_MANAGER
N8N_ENCRYPTION_KEY=OVERRIDDEN_BY_SECRET_MANAGER
N8N_BASIC_AUTH_USER=n8n_admin
N8N_BASIC_AUTH_PASSWORD=OVERRIDDEN_BY_SECRET_MANAGER

# ── 9. Google Cloud Storage (documents backend)
STORAGE_BACKEND=gcs
GCS_BUCKET_NAME=your-project-supportpilot-documents
GCS_PROJECT_ID=your-gcp-project-id

# ── 10. Caddy / HTTPS Domains
ACME_EMAIL=admin@yourdomain.com
DOMAIN_APP=app.yourdomain.com
DOMAIN_API=api.yourdomain.com
DOMAIN_N8N=n8n.yourdomain.com

# ── 11. CORS & Networking
CORS_ORIGINS=https://app.yourdomain.com
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4

# ── 12. Frontend
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_NAME="SupportPilot AI"

# ── 13. Rate Limiting
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# ── 14. File Storage & Quotas
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=pdf,docx,txt,md
# upload_dir is not used when STORAGE_BACKEND=gcs but kept as fallback
UPLOAD_DIR=/app/uploads
